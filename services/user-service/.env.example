NODE_ENV=development
PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@localhost:5433/users
AUTH_JWKS_URL=http://localhost:3000/.well-known/jwks.json
AUTH_JWT_ISSUER=auth-service
AUTH_JWT_AUDIENCE=api
AUTH_JWKS_TIMEOUT_MS=3000
AUTH_JWT_CLOCK_TOLERANCE_SEC=5
# Должно совпадать с EVENT_DELIVERY_TOKEN auth-service.
EVENT_CONSUMER_TOKEN=replace-with-at-least-16-random-characters
