NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth
# bun run jwt:generate-keys — печатает готовые JWT_PRIVATE_KEY/JWT_PUBLIC_KEY/JWT_KID
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KID=
JWT_ISSUER=auth-service
JWT_AUDIENCE=api
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
SESSION_ABSOLUTE_TTL_DAYS=90
# Одинаковое случайное значение EVENT_DELIVERY_TOKEN / EVENT_CONSUMER_TOKEN в двух сервисах.
USER_EVENTS_URL=http://localhost:3001/internal/events
EVENT_DELIVERY_TOKEN=replace-with-at-least-16-random-characters
OUTBOX_CRON_PATTERN="* * * * * *"
OUTBOX_CRON_TIMEZONE=UTC
