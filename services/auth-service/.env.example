NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth
# bun run jwt:generate-keys — печатает готовые JWT_PRIVATE_KEY/JWT_PUBLIC_KEY/JWT_KID
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KID=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
SESSION_ABSOLUTE_TTL_DAYS=90
