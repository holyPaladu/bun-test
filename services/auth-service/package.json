{
  "name": "auth-service",
  "version": "1.0.50",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/server.ts | pino-pretty -c -t 'HH:MM:ss'",
    "start": "bun run src/server.ts",
    "build": "bun build src/server.ts --compile --minify --outfile build/.output",
    "build:migrate": "bun build scripts/migrate.ts --target bun --outfile build/scripts/migrate.js",
    "build:start": "bun run build && ./build/.output",
    "test": "bun test",
    "test:unit": "bun test tests/unit tests/jwt.test.ts",
    "test:e2e": "bun test tests/e2e",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun run scripts/migrate.ts",
    "jwt:generate-keys": "bun run scripts/generate-jwt-keys.ts"
  },
  "dependencies": {
    "@elysiajs/openapi": "1.4.16",
    "@sinclair/typebox": "0.34.52",
    "elysia": "1.4.30",
    "jose": "6.2.10",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "bun-types": "1.4.0",
    "pino-pretty": "13.1.3",
    "typescript": "5.9.3"
  }
}
